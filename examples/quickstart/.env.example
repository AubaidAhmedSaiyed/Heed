# The HEED API Key for this agent workspace
HEED_API_KEY=dev-key

# The URL of the HEED Runtime Control Plane
HEED_URL=http://localhost:4000

# The ID of the agent running this quickstart
HEED_AGENT_ID=code-review-agent

# The GitHub Token used by the connector (Make sure the backend is configured with this as well, if testing end-to-end local.)
GITHUB_TOKEN=your-github-token-here
