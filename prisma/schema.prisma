generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String                @id @default(uuid())
  email       String                @unique
  passwordHash String
  name        String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  memberships WorkspaceMembership[]
}

model WorkspaceMembership {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  role        String    @default("MEMBER") // ADMIN, MEMBER
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
}

model Workspace {
  id          String                @id @default(uuid())
  name        String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  memberships WorkspaceMembership[]
  apiKeys     ApiKey[]
  agents      Agent[]
  policies    Policy[]
  connectors  Connector[]
}

model ApiKey {
  id          String    @id @default(uuid())
  keyHash     String    @unique
  name        String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
}

model Agent {
  id              String            @id @default(uuid())
  name            String
  description     String?
  workspaceId     String
  workspace       Workspace         @relation(fields: [workspaceId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  executions      Execution[]
  behaviorProfile BehaviorProfile?
}

model BehaviorProfile {
  id              String   @id @default(uuid())
  agentId         String   @unique
  agent           Agent    @relation(fields: [agentId], references: [id])
  actionFrequency Json     // Map of action to frequency count/percentage
  systemFrequency Json     // Map of system to frequency count
  resourceFrequency Json   // Map of resource to frequency count
  transitions     ActionTransition[]
  updatedAt       DateTime @updatedAt
}

model ActionTransition {
  id                String          @id @default(uuid())
  behaviorProfileId String
  behaviorProfile   BehaviorProfile @relation(fields: [behaviorProfileId], references: [id])
  fromAction        String          // e.g., "github.read_pull_request"
  toAction          String          // e.g., "github.create_comment"
  frequency         Int             @default(0)

  @@unique([behaviorProfileId, fromAction, toAction])
}

model ExecutionContract {
  id                        String      @id @default(uuid())
  executionId               String      @unique
  execution                 Execution   @relation(fields: [executionId], references: [id])
  objective                 String
  expectedActions           String[]
  allowedSystems            String[]
  allowedCapabilities       String[]
  restrictedResources       String[]
  maxActions                Int?
  maxExternalWrites         Int?
  
  // Phase 4 additions
  forbiddenCapabilities     String[]    @default([])
  forbiddenResourcePatterns String[]    @default([])
  forbiddenProvenance       String[]    @default([])
  terminationConditions     String[]    @default([])
  flowRules                 Json?       // Stored as JSON array of FlowRule objects
  noGoPatterns              Json?       // Stored as JSON array of NoGoPattern objects
  
  createdAt                 DateTime    @default(now())
}

model Execution {
  id              String             @id @default(uuid())
  agentId         String
  agent           Agent              @relation(fields: [agentId], references: [id])
  status          String             // CREATED, RUNNING, PAUSED, AWAITING_APPROVAL, COMPLETED, BLOCKED, TERMINATED, FAILED
  evaluationMode  String             @default("ENFORCE") // OBSERVE, ENFORCE
  impactBudget    Int                @default(30)
  impactConsumed  Int                @default(0)
  trustState      String             @default("TRUSTED") // TRUSTED, UNTRUSTED_INPUT, SENSITIVE_DATA, EXTERNAL_DESTINATION
  objective       String
  
  // Phase 4 additions
  authorityType   String?            // USER, SERVICE, ORGANIZATION, SYSTEM
  authorityId     String?
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  contract        ExecutionContract?
  actions         ActionEvent[]
  interventions   Intervention[]
  events          Event[]
  approvals       ApprovalBinding[]
  snapshots       ExecutionPolicySnapshot[]
  compensations   Compensation[]
}

model ExecutionPolicySnapshot {
  id              String         @id @default(uuid())
  executionId     String
  execution       Execution      @relation(fields: [executionId], references: [id])
  policyVersionId String
  policyVersion   PolicyVersion  @relation(fields: [policyVersionId], references: [id])
  activeAt        DateTime       @default(now())

  @@unique([executionId, policyVersionId])
}

model ActionEvent {
  id                    String        @id @default(uuid())
  executionId           String
  execution             Execution     @relation(fields: [executionId], references: [id])
  system                String
  operation             String
  capability            String?
  resource              String
  resourceType          String?
  sensitivity           String        // PUBLIC, INTERNAL, CONFIDENTIAL, RESTRICTED
  impact                String        @default("LOW") // LOW, MEDIUM, HIGH
  payloadMetadata       Json?         // Redacted/sanitized payload
  status                String        // REQUESTED, ALLOWED, BLOCKED, EXECUTED, FAILED
  timestamp             DateTime      @default(now())
  impactWeight          Int           @default(1)
  reversibility         String        @default("UNKNOWN") // REVERSIBLE, IRREVERSIBLE, UNKNOWN
  impactBefore          Int           @default(0)
  impactAfter           Int           @default(0)
  trustStateBefore      String        @default("TRUSTED")
  trustStateAfter       String        @default("TRUSTED")
  
  // Phase 4 additions
  idempotencyKey        String?       @unique
  provenanceLabels      String[]      @default([])
  provenanceSource      String?
  destinationType       String?
  destinationIdentifier String?
  policySnapshotId      String?
  
  decision              Decision?
  intervention          Intervention?
  approval              ApprovalBinding?
  compensation          Compensation?
}

model Decision {
  id                   String      @id @default(uuid())
  actionEventId        String      @unique
  actionEvent          ActionEvent @relation(fields: [actionEventId], references: [id])
  decision             String      // ALLOW, ASK, BLOCK, ALLOW_CONSTRAINED, BOUND_APPROVAL
  riskScore            Int
  deviationScore       Int
  reasons              String[]
  reasonCode           String?
  
  // Phase 4 additions
  matchedPolicies      Json?       // Stores [{ policyId, version, hash, ruleId }]
  constraints          Json?
  approvalRequirements Json?
  evidenceMetadata     Json?
  trajectoryContext    Json?       // Lookback window / sequence match info
  
  createdAt            DateTime    @default(now())
}

model Intervention {
  id              String      @id @default(uuid())
  executionId     String
  execution       Execution   @relation(fields: [executionId], references: [id])
  actionEventId   String      @unique
  actionEvent     ActionEvent @relation(fields: [actionEventId], references: [id])
  status          String      // PENDING, RESOLVED
  reason          String
  humanDecision   String?     // ALLOW_ONCE, BLOCK, TERMINATE_EXECUTION
  createdAt       DateTime    @default(now())
  resolvedAt      DateTime?
}

model Event {
  id                String    @id @default(uuid())
  executionId       String
  execution         Execution @relation(fields: [executionId], references: [id])
  type              String    // EXECUTION_STARTED, ACTION_REQUESTED, ACTION_ALLOWED, etc.
  payload           Json
  timestamp         DateTime  @default(now())
  
  // Phase 4 additions: Hash chain for tamper-evident logging
  previousEventHash String?
  currentEventHash  String?
}

model Connector {
  id           String    @id @default(uuid())
  name         String    @unique // We'll keep this unique globally for MVP or composite with workspaceId
  capabilities String[]
  status       String    // LOCAL, SIMULATED, ACTIVE
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id])
  createdAt    DateTime  @default(now())
}

// ─── Phase 4 New Models ────────────────────────────────────────

model Policy {
  id          String          @id @default(uuid())
  name        String
  description String?
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    PolicyVersion[]

  @@unique([name, workspaceId])
}

model PolicyVersion {
  id                        String    @id @default(uuid())
  policyId                  String
  policy                    Policy    @relation(fields: [policyId], references: [id])
  version                   Int
  status                    String    // DRAFT, PUBLISHED, DISABLED, ARCHIVED
  priority                  Int       @default(100)
  
  flowRules                 Json      @default("[]")
  noGoPatterns              Json      @default("[]")
  forbiddenCapabilities     String[]  @default([])
  boundApprovalCapabilities String[]  @default([])
  
  createdAt                 DateTime  @default(now())
  createdBy                 String?
  effectiveAt               DateTime?
  supersedesVersion         Int?
  policyHash                String    // Cryptographic hash of the rules
  defaultExecutionBudget    Int       @default(30)
  snapshots                 ExecutionPolicySnapshot[]

  @@unique([policyId, version])
}

model ApprovalBinding {
  id                    String      @id @default(uuid())
  executionId           String
  execution             Execution   @relation(fields: [executionId], references: [id])
  actionEventId         String      @unique
  actionEvent           ActionEvent @relation(fields: [actionEventId], references: [id])
  
  system                String
  operation             String
  capability            String
  resource              String
  argumentsHash         String
  provenanceHash        String
  destinationHash       String
  policySnapshotId      String
  
  expiresAt             DateTime
  consumed              Boolean     @default(false)
  consumedAt            DateTime?
  status                String      // PENDING, APPROVED, REJECTED, EXPIRED, INVALIDATED
  approvedBy            String?
  createdAt             DateTime    @default(now())
}

model Compensation {
  id              String      @id @default(uuid())
  executionId     String
  execution       Execution   @relation(fields: [executionId], references: [id])
  actionEventId   String      @unique
  actionEvent     ActionEvent @relation(fields: [actionEventId], references: [id])
  status          String      // PENDING, RUNNING, SUCCEEDED, FAILED, SKIPPED
  attemptedAt     DateTime    @default(now())
  completedAt     DateTime?
  error           String?
  resultMetadata  Json?
}

model SupportTicket {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  priority      String   // HIGH, CRITICAL, MEDIUM, LOW
  status        String   // OPEN, IN_PROGRESS, RESOLVED
  internalNotes String?
  customerEmail String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
