{
  "name": "heed-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "postinstall": "prisma generate --schema prisma/schema.prisma || true",
    "start:api": "node apps/api/dist/server.js",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "test": "vitest run --passWithNoTests",
    "demo": "node scripts/demo.js",
    "benchmark": "npx ts-node apps/demo-agent/src/benchmark.ts",
    "api": "npm run dev -w apps/api",
    "ui": "npm run dev -w apps/web"
  },
  "dependencies": {
    "@heed-ai/runtime": "^1.0.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.16.0",
    "prisma": "^5.16.0"
  }
}
